{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundloop.dev/schemas/project-config.schema.json",
  "title": "Groundloop project configuration",
  "type": "object",
  "required": ["schema_version", "workspace", "name", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "freshness": {
      "type": "object",
      "properties": {
        "reflection_hours": {"type": "integer", "minimum": 1},
        "remote_hours": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "baseline_ref"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "baseline_ref": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "guidance": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
