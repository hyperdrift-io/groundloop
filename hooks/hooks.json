{
  "description": "Opt-in Groundloop startup orientation. Session learning runs only after the agent process closes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "groundloop hook --host auto --event session-start",
            "commandWindows": "groundloop hook --host auto --event session-start",
            "timeout": 5,
            "statusMessage": "Checking Groundloop freshness"
          }
        ]
      }
    ]
  }
}
